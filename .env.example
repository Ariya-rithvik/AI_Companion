# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# THE SHORT VERSION: the submission needs NO keys.
#     npm run recover      works with this file absent entirely.
# Keys only unlock the optional live segment and the meeting-room chat.

# ─── Razorpay ─── only needed for `recover.mjs --live` ──────────────────────
# dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key.
# Both halves are shown ONCE. The secret cannot be retrieved later - if you
# lose it, regenerate. Key id is ~23 chars, secret is 24.
# Use rzp_test_ only: recover.mjs refuses to run against rzp_live_ keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Only if you point real webhooks at this server. Set the same string in
# Dashboard -> Settings -> Webhooks. Unset = signature checks are still unit
# tested, they just have no live traffic to check.
RAZORPAY_WEBHOOK_SECRET=

# ─── LLM ─── optional. Explanation only, never arithmetic ───────────────────
# Without this, briefs are written by the deterministic template and everything
# still runs. The model may only REPHRASE sentences JavaScript already computed;
# any rewrite that alters a number is rejected. See razorpay/explain.mjs.
LLM_PROVIDER=groq
GROQ_API_KEY=

# ─── Meeting room ─── optional, second surface only ─────────────────────────
PORT=8787
STUN_SERVER=stun:stun.l.google.com:19302
# TURN is only needed for calls that cross NATs. Same-machine demo works without.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
SESSION_SECRET=change-me-any-random-string
